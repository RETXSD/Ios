DEEPSEEK_API_KEY=replace_with_new_rotated_key
PORT=8787

# Use a fast/cheap model for normal chat.
# You can put an exact DeepSeek model id here, or use the alias "flash".
DEEPSEEK_CHAT_MODEL=flash
DEEPSEEK_FLASH_MODEL=deepseek-chat

# Use the stronger model for generated workout plans.
# You can put an exact DeepSeek model id here, or use the alias "pro".
DEEPSEEK_RECOMMENDATION_MODEL=pro
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

DEEPSEEK_TIMEOUT_MS=120000
RECOMMENDATION_TIMEOUT_MS=120000
